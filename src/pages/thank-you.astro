---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title="Thank you" noindex>
  <section class="py-24">
    <div class="container-x max-w-2xl text-center">
      <p class="section-kicker">Request received</p>
      <h1 class="section-title">Thanks, we will be in touch soon.</h1>
      <p class="mt-4 text-muted">We will reach out within one business day to schedule your free inspection. Need something faster? Call <a href={`tel:${site.phone}`} class="font-semibold text-brand-800">{site.phoneDisplay}</a>.</p>
      <a href="/" class="btn-secondary mt-8">Back to home</a>
    </div>
  </section>
</Layout>
