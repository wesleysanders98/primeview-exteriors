---
import { site, services } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-brand-900 text-brand-100">
  <div class="container-x grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="text-lg font-extrabold text-white">{site.name}</p>
      <p class="mt-2 max-w-md text-sm text-brand-100/80">{site.tagline}</p>
      <p class="mt-4 text-sm">Licensed &amp; Insured</p>
    </div>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-white">Services</p>
      <ul class="mt-3 space-y-2 text-sm">
        {services.map((s) => <li><a href="/#services" class="hover:text-white">{s.title}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-white">Contact</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={`tel:${site.phone}`} class="hover:text-white">{site.phoneDisplay}</a></li>
        <li>{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</li>
        <li>{site.hours}</li>
        <li>Serving {site.serviceArea}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-5 text-xs text-brand-100/70 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <p><a href="/privacy" class="hover:text-white">Privacy Policy</a></p>
    </div>
  </div>
</footer>
