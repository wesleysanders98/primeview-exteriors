---
import { site } from '../data/site';
import ContactForm from './ContactForm.astro';
---

<section id="estimate" class="scroll-mt-20 bg-surface py-20">
  <div class="container-x grid gap-10 lg:grid-cols-2">
    <div>
      <p class="section-kicker">Free estimate</p>
      <h2 class="section-title">Ready to talk through your project?</h2>
      <p class="mt-3 max-w-lg text-muted">Send us the basics and we will schedule a free inspection. Prefer to talk? Call us at <a href={`tel:${site.phone}`} class="font-semibold text-brand-800">{site.phoneDisplay}</a>, {site.hours}.</p>
      <ul class="mt-6 space-y-2 text-sm text-muted">
        <li>Written estimates, no obligation</li>
        <li>Storm damage and insurance claim help</li>
        <li>Financing options available</li>
      </ul>
    </div>
    <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line lg:p-8">
      <ContactForm id="estimate-form-bottom" />
    </div>
  </div>
</section>
