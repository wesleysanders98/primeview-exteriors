---
import { whyUs } from '../data/site';
---

<section id="why-us" class="scroll-mt-20 bg-surface py-20">
  <div class="container-x">
    <p class="section-kicker">Why Prime View</p>
    <h2 class="section-title">Our commitment to quality</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {whyUs.map((w) => (
        <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line">
          <h3 class="font-bold text-brand-900">{w.title}</h3>
          <p class="mt-2 text-sm text-muted">{w.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
