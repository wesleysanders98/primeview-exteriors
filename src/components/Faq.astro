---
import { faqs } from '../data/site';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<section id="faq" class="scroll-mt-20 py-20">
  <div class="container-x max-w-3xl">
    <p class="section-kicker">FAQ</p>
    <h2 class="section-title">Common questions</h2>
    <div class="mt-8 divide-y divide-line rounded-xl border border-line">
      {faqs.map((f) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-brand-900">
            {f.q}
            <span class="text-accent-500 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-sm text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
